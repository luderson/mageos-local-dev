# Copy this file to .env and adjust, or just run ./setup.sh which writes .env for you.
# Values here are safe non-secret placeholders; setup.sh generates real passwords.

# ---- General ----
COMPOSE_PROJECT_NAME=mageos
# Base local hostname WITHOUT the .local suffix -- setup.sh appends it, e.g.
# BASE_DOMAIN=mystore.local
BASE_DOMAIN=mageos.local

# ---- Host user mapping (fills automatically from `id -u`/`id -g` in setup.sh) ----
# Matching the container's non-root user to your host UID/GID avoids permission
# mismatches on the bind-mounted ./src directory.
HOST_UID=1000
HOST_GID=1000

# ---- PHP ----
# MageOS 3.x+ target. Pick one of: 8.1 | 8.2 | 8.3
PHP_VERSION=8.3

# ---- Database ----
DB_DATABASE=mageos
DB_USER=mageos
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
MARIADB_VERSION=10.6

# ---- Redis ----
REDIS_VERSION=7.2-alpine

# ---- OpenSearch ----
OPENSEARCH_VERSION=2.15.0

# ---- RabbitMQ ----
RABBITMQ_VERSION=3.13-management-alpine
RABBITMQ_USER=mageos
RABBITMQ_PASSWORD=changeme

# ---- Mailpit ----
MAILPIT_VERSION=v1.20.3

# ---- Node / Grunt (theme build watcher) ----
NODE_VERSION=20.11.0

# ---- Magento admin (used only by setup.sh during setup:install) ----
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=changeme123!
MAGENTO_ADMIN_EMAIL=admin@example.com
MAGENTO_ADMIN_FIRSTNAME=Admin
MAGENTO_ADMIN_LASTNAME=User
